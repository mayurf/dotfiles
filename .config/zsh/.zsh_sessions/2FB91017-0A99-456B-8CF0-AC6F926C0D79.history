git switch main
wtp ls
wtp cd #bash\
# Create a fresh PSBE staging member and save credentials to\
# mynotes/_users/<email-local-part>.json so the user is reusable.\
#\
# Usage:\
#   ./create-user.sh                                  # auto-generate everything\
#   ./create-user.sh --email foo@bar.com              # use a specific email\
#   ./create-user.sh --card-type Mastercard           # Visa | Mastercard | Amex | Discover\
#   ./create-user.sh --first-name Pat --last-name T.\
#   ./create-user.sh --notes "for NOP-XXX duplicate-email test"\
#   ./create-user.sh --password Custom123             # default: Testing123\
#\
# Requires: curl, jq, awk, bash 4+.\
\
set -euo pipefail\
\
# --- Defaults ---\
EMAIL=""\
CARD_TYPE="Visa"\
FIRST_NAME="Pat"\
LAST_NAME="Tester"\
NOTES=""\
PASSWORD="Testing123"\
ZIP="60606"\
ADDRESS1="540 W. Madison St."\
ADDRESS2="Suite 2400"\
CITY="Chicago"\
STATE="IL"\
\
# --- Args ---\
while [[ $# -gt 0 ]]; do\
  case "$1" in\
    --email)      EMAIL="$2"; shift 2 ;;\
    --card-type)  CARD_TYPE="$2"; shift 2 ;;\
    --first-name) FIRST_NAME="$2"; shift 2 ;;\
    --last-name)  LAST_NAME="$2"; shift 2 ;;\
    --notes)      NOTES="$2"; shift 2 ;;\
    --password)   PASSWORD="$2"; shift 2 ;;\
    -h|--help)\
      awk 'NR==1{next} /^#/{sub(/^# ?/, ""); print; next} {exit}' "$0"\
      exit 0\
      ;;\
    *) echo "Unknown arg: $1" >&2; exit 2 ;;\
  esac\
done\
\
# --- Resolve paths ---\
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"\
\
if [[ -z "$EMAIL" ]]; then\
  EMAIL="nova-test-$(date +%Y%m%d-%H%M%S)@mailinator.com"\
fi\
\
LOCAL_PART="${EMAIL%%@*}"\
USER_FILE="$SCRIPT_DIR/${LOCAL_PART}.json"\
\
if [[ -e "$USER_FILE" ]]; then\
  echo "Refusing to overwrite $USER_FILE â€ƒ´ delete it first if you want to re-create." >&2\
  exit 1\
fi\
\
PSBE="https://partner-sites-back-end-nosh.mdv-stg.idine.com"\
VELCRO_URL="https://velcro-wallet.mdv-stg.idine.com/encrypted?environment=stg&cardType=${CARD_TYPE}"\
\
# PSBE expects uppercase card type; normalize.\
case "$(echo "$CARD_TYPE" | tr '[:lower:]' '[:upper:]')" in\
  VISA)       CARD_TYPE_PSBE="VISA" ;;\
  MASTERCARD) CARD_TYPE_PSBE="MASTERCARD" ;;\
  AMEX)       CARD_TYPE_PSBE="AMEX" ;;\
  DISCOVER)   CARD_TYPE_PSBE="DISCOVER" ;;\
  *)\
    echo "Unsupported --card-type '$CARD_TYPE' (use Visa, Mastercard, Amex, Discover)" >&2\
    exit 2 ;;\
esac\
\
# --- Step 1: velcro ---\
echo ">>> Fetching encrypted card from velcro ($CARD_TYPE)..." >&2\
VELCRO=$(curl -fsSL "$VELCRO_URL")\
ENC_CARD=$(echo "$VELCRO" | jq -r '.encryptedCardNumber_RSA_Sha1 // empty')\
PAN=$(echo "$VELCRO" | jq -r '.plainTextCardNumber // empty')\
if [[ -z "$ENC_CARD" || -z "$PAN" ]]; then\
  echo "velcro returned an unexpected shape:" >&2\
  echo "$VELCRO" | jq . >&2 2>/dev/null || echo "$VELCRO" >&2\
  exit 1\
fi\
LAST4="${PAN: -4}"\
\
# --- Step 2: CSRF preflight ---\
# PSBE issues XSRF-TOKEN with Domain=neighborhoodnoshrewards.rnstg.com (not the API\
# host), so curl's -c jar drops it. We awk it out of the raw Set-Cookie header.\
echo ">>> CSRF preflight ($PSBE/)..." >&2\
CSRF=$(curl -sSI "$PSBE/" 2>/dev/null | awk '\
  tolower($1) == "set-cookie:" {\
    n = split($0, parts, /[ \t;]+/)\
    for (i = 1; i <= n; i++) {\
      if (parts[i] ~ /^XSRF-TOKEN=/) {\
        sub(/^XSRF-TOKEN=/, "", parts[i])\
        print parts[i]\
        exit\
      }\
    }\
  }')\
if [[ -z "$CSRF" ]]; then\
  echo "No XSRF-TOKEN in Set-Cookie from $PSBE/" >&2\
  exit 1\
fi\
\
# --- Step 3: enroll ---\
PPN=$(printf '%010d' $((RANDOM * RANDOM)))\
PHONE="312555$(printf '%04d' $((RANDOM % 10000)))"\
\
BODY=$(jq -nc \\
  --arg fn "$FIRST_NAME" --arg ln "$LAST_NAME" --arg zip "$ZIP" \\
  --arg ppn "$PPN" --arg email "$EMAIL" --arg pw "$PASSWORD" \\
  --arg ct "$CARD_TYPE_PSBE" --arg last4 "$LAST4" --arg enc "$ENC_CARD" \\
  --arg a1 "$ADDRESS1" --arg a2 "$ADDRESS2" --arg city "$CITY" --arg state "$STATE" \\
  --arg phone "$PHONE" '{\
    firstName: $fn, lastName: $ln, zipCode: $zip,\
    partnerProgramNumber: $ppn, email: $email, password: $pw,\
    emailOptIn: true, acceptTOS: true, directFileFeedOptIn: true,\
    creditCards: [{ cardType: $ct, lastFour: $last4, encryptedCardNumber: $enc }],\
    address1: $a1, address2: $a2, city: $city, state: $state,\
    phoneNumber: $phone, smsOptIn: true,\
    referral: {\
      utmSource: "local-test", utmMedium: "local-test", utmCampaign: "local-test",\
      utmTerm: "local-test", utmContent: "local-test", referrer: "local-test", source: "local-test"\
    },\
    "g-recaptcha-response": "stg-bypass"\
  }')\
\
echo ">>> Enrolling $EMAIL..." >&2\
RESP_FILE=$(mktemp)\
trap 'rm -f "$RESP_FILE"' EXIT\
HTTP_CODE=$(curl -sS -o "$RESP_FILE" -w '%{http_code}' \\
  -X POST "$PSBE/api/Enrollment" \\
  -H "Content-Type: application/json" \\
  -H "Cookie: XSRF-TOKEN=$CSRF" \\
  -H "X-Xsrf-Token: $CSRF" \\
  --data-binary "$BODY")\
\
if [[ "$HTTP_CODE" != "200" ]]; then\
  echo "Enrollment failed: HTTP $HTTP_CODE" >&2\
  jq . < "$RESP_FILE" 2>/dev/null || cat "$RESP_FILE" >&2\
  echo >&2\
  exit 1\
fi\
\
PUBLIC_ID=$(jq -r '.member.publicId // .publicId // empty' < "$RESP_FILE")\
WEB_ID_RAW=$(jq -r '.member.webId // .webId // empty' < "$RESP_FILE")\
CAMPAIGN=$(jq -r '.member.campaignCode // .campaignCode // empty' < "$RESP_FILE")\
\
if [[ "$WEB_ID_RAW" =~ ^[0-9]+$ ]]; then\
  WEB_ID_JSON="$WEB_ID_RAW"\
else\
  WEB_ID_JSON="null"\
fi\
\
# --- Step 4: write the user file ---\
jq -n \\
  --arg email "$EMAIL" --arg pw "$PASSWORD" \\
  --arg fn "$FIRST_NAME" --arg ln "$LAST_NAME" \\
  --arg ppn "$PPN" --arg public_id "$PUBLIC_ID" --argjson web_id "$WEB_ID_JSON" \\
  --arg a1 "$ADDRESS1" --arg a2 "$ADDRESS2" --arg city "$CITY" --arg state "$STATE" --arg zip "$ZIP" \\
  --arg phone "$PHONE" \\
  --arg ct "$CARD_TYPE_PSBE" --arg last4 "$LAST4" \\
  --arg campaign "$CAMPAIGN" --arg notes "$NOTES" \\
  --arg date "$(date +%Y-%m-%d)" '{\
    email: $email,\
    password: $pw,\
    firstName: $fn,\
    lastName: $ln,\
    partnerProgramNumber: $ppn,\
    publicId: $public_id,\
    webId: $web_id,\
    address: {\
      address1: $a1, address2: $a2, city: $city, state: $state, zipCode: $zip\
    },\
    phoneNumber: $phone,\
    creditCard: {\
      cardType: $ct,\
      lastFour: $last4,\
      note: "Encrypted via velcro RSA_Sha1; not retained. Get a fresh encrypted card from velcro before reusing this user for card-add/charge flows."\
    },\
    campaignCode: $campaign,\
    partnerCode: "IDIN",\
    enrolledAt: $date,\
    notes: $notes\
  }' > "$USER_FILE"\
\
echo ">>> Saved $USER_FILE" >&2\
echo\
jq . < "$USER_FILE"\

