[submodule ".config/zsh/plugins/powerlevel10k"]
	path = .config/zsh/plugins/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
[submodule ".config/zsh/plugins/fast-syntax-highlighting"]
	path = .config/zsh/plugins/fast-syntax-highlighting
	url = https://github.com/zdharma-continuum/fast-syntax-highlighting.git
[submodule ".config/zsh/plugins/zsh-history-substring-search"]
	path = .config/zsh/plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search.git
[submodule ".config/zsh/plugins/zsh-autosuggestions"]
	path = .config/zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
[submodule ".config/zsh/plugins/zsh-smartcache"]
	path = .config/zsh/plugins/zsh-smartcache
	url = https://github.com/QuarticCat/zsh-smartcache.git
[submodule ".config/lazyvim"]
	path = .config/lazyvim
	url = git@github.com:mayurf/lazyvim.git
[submodule ".config/nvim"]
	path = .config/nvim
	url = git@github.com:mayurf/lazyvim.git
[submodule ".config/zsh/plugins/ez-compinit"]
	path = .config/zsh/plugins/ez-compinit
	url = https://github.com/mattmc3/ez-compinit
[submodule ".config/zsh/.config/zsh/plugins/fzf-tab"]
	path = .config/zsh/.config/zsh/plugins/fzf-tab
	url = https://github.com/Aloxaf/fzf-tab
